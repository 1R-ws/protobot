<?xml version="1.0"?>
<sdf version="1.10">
  <model name="exam_chair">
    <static>true</static>

    <link name="chair">

      <!-- Inertia -->
      <inertial>
        <mass>3</mass>
        <inertia>
          <ixx>0.1</ixx><iyy>0.1</iyy><izz>0.1</izz>
        </inertia>
      </inertial>

      <!-- SEAT -->
      <visual name="seat">
        <pose>0 0 0.45 0 0 0</pose>
        <geometry>
          <box><size>0.45 0.45 0.04</size></box>
        </geometry>
        <material>
          <diffuse>0.9 0.9 0.92 1</diffuse>
          <specular>0.3 0.3 0.35 1</specular>
        </material>
      </visual>

      <collision name="seat_col">
        <pose>0 0 0.45 0 0 0</pose>
        <geometry><box><size>0.45 0.45 0.04</size></box></geometry>
      </collision>

      <!-- BACKREST -->

      <visual name="back">
        <pose>0 0.215 0.78 0 0 0</pose>
        <geometry>
          <box><size>0.45 0.03 0.50</size></box>
        </geometry>
        <material>
          <diffuse>0.9 0.9 0.92 1</diffuse>
          <specular>0.3 0.3 0.35 1</specular>
        </material>
      </visual>

      <collision name="back_col">
        <pose>0 0.215 0.78 0 0 0</pose>
        <geometry>
          <box><size>0.45 0.03 0.50</size></box>
        </geometry>
      </collision>


      <!-- LEGS -->
      <visual name="leg1"><pose>-0.17 -0.17 0.225 0 0 0</pose><geometry><cylinder><radius>0.025</radius><length>0.45</length></cylinder></geometry><material><diffuse>0.85 0.85 0.88 1</diffuse></material></visual>
      <visual name="leg2"><pose> 0.17 -0.17 0.225 0 0 0</pose><geometry><cylinder><radius>0.025</radius><length>0.45</length></cylinder></geometry><material><diffuse>0.85 0.85 0.88 1</diffuse></material></visual>
      <visual name="leg3"><pose>-0.17  0.17 0.225 0 0 0</pose><geometry><cylinder><radius>0.025</radius><length>0.45</length></cylinder></geometry><material><diffuse>0.85 0.85 0.88 1</diffuse></material></visual>
      <visual name="leg4"><pose> 0.17  0.17 0.225 0 0 0</pose><geometry><cylinder><radius>0.025</radius><length>0.45</length></cylinder></geometry><material><diffuse>0.85 0.85 0.88 1</diffuse></material></visual>

      <collision name="leg1_col"><pose>-0.17 -0.17 0.225 0 0 0</pose><geometry><cylinder><radius>0.025</radius><length>0.45</length></cylinder></geometry></collision>
      <collision name="leg2_col"><pose> 0.17 -0.17 0.225 0 0 0</pose><geometry><cylinder><radius>0.025</radius><length>0.45</length></cylinder></geometry></collision>
      <collision name="leg3_col"><pose>-0.17  0.17 0.225 0 0 0</pose><geometry><cylinder><radius>0.025</radius><length>0.45</length></cylinder></geometry></collision>
      <collision name="leg4_col"><pose> 0.17  0.17 0.225 0 0 0</pose><geometry><cylinder><radius>0.025</radius><length>0.45</length></cylinder></geometry></collision>

    </link>
  </model>
</sdf>
