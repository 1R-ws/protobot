<?xml version="1.0"?>
<sdf version="1.10">
  <model name="exam_desk">
    <static>true</static>
    <link name="desk">
      <inertial>
        <mass>5</mass>
        <inertia>
          <ixx>0.5</ixx>
          <iyy>0.5</iyy>
          <izz>0.5</izz>
        </inertia>
      </inertial>

      <!-- Collision: tabletop -->
      <collision name="col_top">
        <geometry>
          <box>
            <size>0.9 0.5 0.02</size>
          </box>
        </geometry>
        <pose>0 0 0.74 0 0 0</pose>
      </collision>

      <!-- Collision: thicker legs (0.05m x 0.05m x 0.74m) -->
      <collision name="col_leg1">
        <geometry>
          <box><size>0.05 0.05 0.74</size></box>
        </geometry>
        <pose>0.40 0.22 0.37 0 0 0</pose>
      </collision>
      <collision name="col_leg2">
        <geometry>
          <box><size>0.05 0.05 0.74</size></box>
        </geometry>
        <pose>-0.40 0.22 0.37 0 0 0</pose>
      </collision>
      <collision name="col_leg3">
        <geometry>
          <box><size>0.05 0.05 0.74</size></box>
        </geometry>
        <pose>0.40 -0.22 0.37 0 0 0</pose>
      </collision>
      <collision name="col_leg4">
        <geometry>
          <box><size>0.05 0.05 0.74</size></box>
        </geometry>
        <pose>-0.40 -0.22 0.37 0 0 0</pose>
      </collision>

      <!-- Visual: tabletop -->
      <visual name="visual_top">
        <geometry>
          <box><size>0.9 0.5 0.02</size></box>
        </geometry>
        <pose>0 0 0.74 0 0 0</pose>
        <material>
          <diffuse>0.88 0.82 0.65 1</diffuse>
        </material>
      </visual>

      <!-- Visual: thicker legs -->
      <visual name="visual_leg1">
        <geometry><box><size>0.05 0.05 0.74</size></box></geometry>
        <pose>0.40 0.22 0.37 0 0 0</pose>
        <material><diffuse>0.3 0.3 0.3 1</diffuse></material>
      </visual>
      <visual name="visual_leg2">
        <geometry><box><size>0.05 0.05 0.74</size></box></geometry>
        <pose>-0.40 0.22 0.37 0 0 0</pose>
        <material><diffuse>0.3 0.3 0.3 1</diffuse></material>
      </visual>
      <visual name="visual_leg3">
        <geometry><box><size>0.05 0.05 0.74</size></box></geometry>
        <pose>0.40 -0.22 0.37 0 0 0</pose>
        <material><diffuse>0.3 0.3 0.3 1</diffuse></material>
      </visual>
      <visual name="visual_leg4">
        <geometry><box><size>0.05 0.05 0.74</size></box></geometry>
        <pose>-0.40 -0.22 0.37 0 0 0</pose>
        <material><diffuse>0.3 0.3 0.3 1</diffuse></material>
      </visual>

    </link>
  </model>
</sdf>
