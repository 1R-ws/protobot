<?xml version="1.0" ?>
<sdf version="1.10">
  <world name="exam_hall">

    <!-- ==================== PHYSICS & PLUGINS ==================== -->
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>

    <plugin name="gz::sim::systems::Physics" filename="gz-sim-physics-system"/>
    <plugin name="gz::sim::systems::UserCommands" filename="gz-sim-user-commands-system"/>
    <plugin name="gz::sim::systems::SceneBroadcaster" filename="gz-sim-scene-broadcaster-system"/>
    <plugin name="gz::sim::systems::Sensors" filename="gz-sim-sensors-system">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin name="gz::sim::systems::Contact" filename="gz-sim-contact-system"/>

    <!-- ==================== GLOBAL SETTINGS ==================== -->
    <gravity>0 0 -9.81</gravity>
    <scene>
      <ambient>0.3 0.3 0.3 1</ambient>
      <background>0.9 0.9 0.95 1</background>
      <shadows>true</shadows>
    </scene>

    <!-- ==================== FLOOR ==================== -->
    <model name="floor">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>20 15</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>20 15</size></plane></geometry>
          <material><diffuse>0.85 0.85 0.85 1</diffuse></material>
        </visual>
      </link>
      <pose>0 8 0 0 0 0</pose>
    </model>

    <!-- ==================== WALLS ==================== -->
    <include><uri>model://wall_segment</uri><name>wall_north</name><pose>0 17.5 1.5 0 0 0</pose></include>
    <include><uri>model://wall_segment</uri><name>wall_south</name><pose>0 -1.5 1.5 0 0 3.14159</pose></include>
    <include><uri>model://wall_segment</uri><name>wall_east</name><pose>9 8 1.5 0 0 1.5708</pose></include>
    <include><uri>model://wall_segment</uri><name>wall_west</name><pose>-9 8 1.5 0 0 -1.5708</pose></include>

    <!-- ==================== LIGHTS ==================== -->
    <light name="light1" type="directional"><pose>-5 8 2.9 0 0 0</pose><diffuse>1 1 0.95 1</diffuse><intensity>0.8</intensity><direction>0 0 -1</direction></light>
    <light name="light2" type="directional"><pose>5 8 2.9 0 0 0</pose><diffuse>1 1 0.95 1</diffuse><intensity>0.8</intensity><direction>0 0 -1</direction></light>
    <light name="light3" type="directional"><pose>0 4 2.9 0 0 0</pose><diffuse>1 1 0.95 1</diffuse><intensity>0.8</intensity><direction>0 0 -1</direction></light>
    <light name="light4" type="directional"><pose>0 12 2.9 0 0 0</pose><diffuse>1 1 0.95 1</diffuse><intensity>0.8</intensity><direction>0 0 -1</direction></light>

    <!-- ==================== LECTURE DESK ==================== -->
    <include><uri>model://lecture_desk</uri><pose>6 14 0 0 0 0</pose><name>teacher_desk_front</name></include>

    <include><uri>model://lecture_desk</uri><pose>-6 0 0 0 0 0</pose><name>teacher_desk_back</name></include>

    <!-- ==================== EXAM DESKS & CHAIRS (SHIFTED +8 Y) ==================== -->

    <!-- Row 0 -->
    <include><uri>model://exam_desk</uri><pose>-6 3 0 0 0 0</pose><name>desk_0_0</name></include>
    <include><uri>model://exam_chair</uri><pose>-6 2.35 0 0 0 3.14159</pose><name>chair_0_0</name></include>

    <include><uri>model://exam_desk</uri><pose>-3 3 0 0 0 0</pose><name>desk_0_1</name></include>
    <include><uri>model://exam_chair</uri><pose>-3 2.35 0 0 0 3.14159</pose><name>chair_0_1</name></include>

    <include><uri>model://exam_desk</uri><pose>0 3 0 0 0 0</pose><name>desk_0_2</name></include>
    <include><uri>model://exam_chair</uri><pose>0 2.35 0 0 0 3.14159</pose><name>chair_0_2</name></include>

    <include><uri>model://exam_desk</uri><pose>3 3 0 0 0 0</pose><name>desk_0_3</name></include>
    <include><uri>model://exam_chair</uri><pose>3 2.35 0 0 0 3.14159</pose><name>chair_0_3</name></include>

    <include><uri>model://exam_desk</uri><pose>6 3 0 0 0 0</pose><name>desk_0_4</name></include>
    <include><uri>model://exam_chair</uri><pose>6 2.35 0 0 0 3.14159</pose><name>chair_0_4</name></include>

    <!-- Row 1 -->
    <include><uri>model://exam_desk</uri><pose>-6 4.7 0 0 0 0</pose><name>desk_1_0</name></include>
    <include><uri>model://exam_chair</uri><pose>-6 4.05 0 0 0 3.14159</pose><name>chair_1_0</name></include>

    <include><uri>model://exam_desk</uri><pose>-3 4.7 0 0 0 0</pose><name>desk_1_1</name></include>
    <include><uri>model://exam_chair</uri><pose>-3 4.05 0 0 0 3.14159</pose><name>chair_1_1</name></include>

    <include><uri>model://exam_desk</uri><pose>0 4.7 0 0 0 0</pose><name>desk_1_2</name></include>
    <include><uri>model://exam_chair</uri><pose>0 4.05 0 0 0 3.14159</pose><name>chair_1_2</name></include>

    <include><uri>model://exam_desk</uri><pose>3 4.7 0 0 0 0</pose><name>desk_1_3</name></include>
    <include><uri>model://exam_chair</uri><pose>3 4.05 0 0 0 3.14159</pose><name>chair_1_3</name></include>

    <include><uri>model://exam_desk</uri><pose>6 4.7 0 0 0 0</pose><name>desk_1_4</name></include>
    <include><uri>model://exam_chair</uri><pose>6 4.05 0 0 0 3.14159</pose><name>chair_1_4</name></include>

    <!-- Row 2 -->
    <include><uri>model://exam_desk</uri><pose>-6 6.4 0 0 0 0</pose><name>desk_2_0</name></include>
    <include><uri>model://exam_chair</uri><pose>-6 5.75 0 0 0 3.14159</pose><name>chair_2_0</name></include>

    <include><uri>model://exam_desk</uri><pose>-3 6.4 0 0 0 0</pose><name>desk_2_1</name></include>
    <include><uri>model://exam_chair</uri><pose>-3 5.75 0 0 0 3.14159</pose><name>chair_2_1</name></include>

    <include><uri>model://exam_desk</uri><pose>0 6.4 0 0 0 0</pose><name>desk_2_2</name></include>
    <include><uri>model://exam_chair</uri><pose>0 5.75 0 0 0 3.14159</pose><name>chair_2_2</name></include>

    <include><uri>model://exam_desk</uri><pose>3 6.4 0 0 0 0</pose><name>desk_2_3</name></include>
    <include><uri>model://exam_chair</uri><pose>3 5.75 0 0 0 3.14159</pose><name>chair_2_3</name></include>

    <include><uri>model://exam_desk</uri><pose>6 6.4 0 0 0 0</pose><name>desk_2_4</name></include>
    <include><uri>model://exam_chair</uri><pose>6 5.75 0 0 0 3.14159</pose><name>chair_2_4</name></include>

    <!-- Row 3 -->
    <include><uri>model://exam_desk</uri><pose>-6 8.1 0 0 0 0</pose><name>desk_3_0</name></include>
    <include><uri>model://exam_chair</uri><pose>-6 7.45 0 0 0 3.14159</pose><name>chair_3_0</name></include>

    <include><uri>model://exam_desk</uri><pose>-3 8.1 0 0 0 0</pose><name>desk_3_1</name></include>
    <include><uri>model://exam_chair</uri><pose>-3 7.45 0 0 0 3.14159</pose><name>chair_3_1</name></include>

    <include><uri>model://exam_desk</uri><pose>0 8.1 0 0 0 0</pose><name>desk_3_2</name></include>
    <include><uri>model://exam_chair</uri><pose>0 7.45 0 0 0 3.14159</pose><name>chair_3_2</name></include>

    <include><uri>model://exam_desk</uri><pose>3 8.1 0 0 0 0</pose><name>desk_3_3</name></include>
    <include><uri>model://exam_chair</uri><pose>3 7.45 0 0 0 3.14159</pose><name>chair_3_3</name></include>

    <include><uri>model://exam_desk</uri><pose>6 8.1 0 0 0 0</pose><name>desk_3_4</name></include>
    <include><uri>model://exam_chair</uri><pose>6 7.45 0 0 0 3.14159</pose><name>chair_3_4</name></include>

    <!-- Row 4 -->
    <include><uri>model://exam_desk</uri><pose>-6 9.8 0 0 0 0</pose><name>desk_4_0</name></include>
    <include><uri>model://exam_chair</uri><pose>-6 9.15 0 0 0 3.14159</pose><name>chair_4_0</name></include>

    <include><uri>model://exam_desk</uri><pose>-3 9.8 0 0 0 0</pose><name>desk_4_1</name></include>
    <include><uri>model://exam_chair</uri><pose>-3 9.15 0 0 0 3.14159</pose><name>chair_4_1</name></include>

    <include><uri>model://exam_desk</uri><pose>0 9.8 0 0 0 0</pose><name>desk_4_2</name></include>
    <include><uri>model://exam_chair</uri><pose>0 9.15 0 0 0 3.14159</pose><name>chair_4_2</name></include>

    <include><uri>model://exam_desk</uri><pose>3 9.8 0 0 0 0</pose><name>desk_4_3</name></include>
    <include><uri>model://exam_chair</uri><pose>3 9.15 0 0 0 3.14159</pose><name>chair_4_3</name></include>

    <include><uri>model://exam_desk</uri><pose>6 9.8 0 0 0 0</pose><name>desk_4_4</name></include>
    <include><uri>model://exam_chair</uri><pose>6 9.15 0 0 0 3.14159</pose><name>chair_4_4</name></include>

    <!-- Row 5 -->
    <include><uri>model://exam_desk</uri><pose>-6 11.5 0 0 0 0</pose><name>desk_5_0</name></include>
    <include><uri>model://exam_chair</uri><pose>-6 10.85 0 0 0 3.14159</pose><name>chair_5_0</name></include>

    <include><uri>model://exam_desk</uri><pose>-3 11.5 0 0 0 0</pose><name>desk_5_1</name></include>
    <include><uri>model://exam_chair</uri><pose>-3 10.85 0 0 0 3.14159</pose><name>chair_5_1</name></include>

    <include><uri>model://exam_desk</uri><pose>0 11.5 0 0 0 0</pose><name>desk_5_2</name></include>
    <include><uri>model://exam_chair</uri><pose>0 10.85 0 0 0 3.14159</pose><name>chair_5_2</name></include>

    <include><uri>model://exam_desk</uri><pose>3 11.5 0 0 0 0</pose><name>desk_5_3</name></include>
    <include><uri>model://exam_chair</uri><pose>3 10.85 0 0 0 3.14159</pose><name>chair_5_3</name></include>

    <include><uri>model://exam_desk</uri><pose>6 11.5 0 0 0 0</pose><name>desk_5_4</name></include>
    <include><uri>model://exam_chair</uri><pose>6 10.85 0 0 0 3.14159</pose><name>chair_5_4</name></include>

  </world>
</sdf>
